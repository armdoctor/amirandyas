# Preview/demo mode: guests + RSVPs live in memory (nothing is saved).
# Leave as "1" until a real database is connected.
DEMO_MODE="1"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in demo mode (a built-in preview secret is used if unset). REQUIRED once DEMO_MODE is off.
SESSION_SECRET=""

# Shared admin password for the /admin dashboard (Amir, Yasmin, Armand).
# In demo mode this defaults to "amiryasmin2027" if unset.
ADMIN_PASSWORD=""
