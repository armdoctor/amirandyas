# Neon Postgres connection string for AMIR & YASMIN's database ONLY.
# Never point this at Azure & Lauren's database.
# For local tinkering, use a Neon *branch* of this database, not main.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-fresh-64-char-hex-string"

# Shared admin password for /admin (Amir, Yasmin, Armand)
ADMIN_PASSWORD=""

# Set to "1" ONLY for a throwaway preview with sample guests and no database.
# DEMO_MODE="1"
